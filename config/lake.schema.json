{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lake Lab configuration",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "name",
    "center",
    "bounds",
    "timeZone",
    "outline",
    "monitoringSites",
    "stations",
    "datasets",
    "content",
    "credits"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "center": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "number"
      }
    },
    "bounds": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "number"
      }
    },
    "timeZone": {
      "type": "string"
    },
    "outline": {
      "type": "object",
      "required": [
        "file",
        "sourceId"
      ]
    },
    "monitoringSites": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "coordinates",
          "sourceId"
        ]
      }
    },
    "stations": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "enabled",
          "module",
          "content",
          "status"
        ],
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "module": {
            "type": "string"
          },
          "content": {
            "type": "string"
          },
          "status": {
            "enum": [
              "preview",
              "ready"
            ]
          }
        }
      }
    },
    "datasets": {
      "type": "string"
    },
    "content": {
      "type": "object",
      "required": [
        "common",
        "glossary"
      ]
    },
    "seasonalRanges": {
      "type": [
        "object",
        "null"
      ]
    },
    "credits": {
      "type": "object",
      "required": [
        "creator",
        "repositoryUrl",
        "siblingUrl",
        "codeLicense",
        "contentLicense"
      ],
      "properties": {
        "repositoryUrl": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
